# Copy to .env.local for local development, and add the same keys
# in Vercel → Project → Settings → Environment Variables.

# Your GitHub username (drives the live repository showcase)
NEXT_PUBLIC_GITHUB_USERNAME=Kumarvishal1225nn

# Public contact details shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=kumar.vishal.iitropar@gmail.com
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/kumar-vishal-73aa69236/

# Your deployed URL (used for SEO metadata / sitemap)
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# OPTIONAL — server-only. Raises the GitHub API rate limit from 60 to 5000/h.
# A fine-grained token with NO permissions (public data only) is enough.
# Never prefix this with NEXT_PUBLIC_ — that would expose it in the browser.
GITHUB_TOKEN=
